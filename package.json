{
  "name": "google-messages-for-desktop",
  "version": "2.0.0",
  "description": "A \"native-like\" desktop app for Google Messages.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:tray": "electron . --tray",
    "build:mac": "electron-builder --mac",
    "build:windows": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --mac --win --linux",
    "clean:dist": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cvlogg/Google-Messages-For-Desktop.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Kelvin Nguyen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cvlogg/Google-Messages-For-Desktop/issues"
  },
  "homepage": "https://github.com/cvlogg/Google-Messages-For-Desktop#readme",
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.googlemessages.desktop",
    "productName": "Google Messages",
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "icons/icon.png",
        "to": "icon.png"
      },
      {
        "from": "icons/icon.ico",
        "to": "icon.ico"
      }
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "icons/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "icon": "icons/icon.png",
      "category": "Network;InstantMessaging",
      "target": [
        "AppImage",
        "deb",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
